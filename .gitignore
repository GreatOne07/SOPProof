# Secrets — never commit credentials
.env
*.pem
*.key

# Python environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local data: databases, real user evidence, generated reports
data/
uploads/
outputs/

# Backups and editor/OS noise
backups/
*.bak
.DS_Store

# Large test fixtures (kept locally, not in Git history)
hardhat_video.mp4
hardhat_tracking_preview.avi
no_helmet_test.mp4
sam_video_raw.txt
sam_video_person_raw.txt

# Synthetic guest demo: keep the complete demo dataset. The generic
# outputs/ rule above would otherwise swallow the video demo tree.
!demo_data/de0000000003/outputs/
!demo_data/de0000000003/outputs/**

